PINERARY_HTTP_ADDR=:8080
PINERARY_ALLOWED_ORIGINS=http://localhost:3000
PINERARY_DATABASE_URL=postgres://pinerary:pinerary@localhost:5432/pinerary?sslmode=disable
# Auth0 OIDC. Set mode to development only for isolated local/Postman testing.
PINERARY_AUTH_MODE=oidc
PINERARY_OIDC_ISSUER_URL=https://pinerary-prod.eu.auth0.com/
PINERARY_OIDC_AUDIENCE=https://api.pinerary
PINERARY_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Replace this with an identifier containing a real contact before public deployment.
PINERARY_NOMINATIM_USER_AGENT="Pinerary/0.1 (contact@example.com)"
# Set to geoapify after adding a free server-side API key. Keep disabled to run without suggestions.
PINERARY_PLACE_SEARCH_PROVIDER=disabled
PINERARY_GEOAPIFY_BASE_URL=https://api.geoapify.com
PINERARY_GEOAPIFY_API_KEY=
# Stay below Geoapify's current 3,000-credit free daily allowance.
PINERARY_GEOAPIFY_DAILY_BUDGET=2500
PINERARY_VALHALLA_URL=http://localhost:8002
PINERARY_OBJECT_ENDPOINT=localhost:9000
PINERARY_OBJECT_ACCESS_KEY=pinerary
PINERARY_OBJECT_SECRET_KEY=pinerary-secret
PINERARY_OBJECT_BUCKET=pinerary-media
PINERARY_OBJECT_USE_TLS=false
PINERARY_MAX_PHOTO_BYTES=15728640
PINERARY_PUBLIC_BASE_URL=http://localhost:8080
PINERARY_VAPID_SUBSCRIBER=mailto:contact@example.com
PINERARY_VAPID_PUBLIC_KEY=
PINERARY_VAPID_PRIVATE_KEY=
# Optional. Example: http://localhost:4318/v1/traces
PINERARY_OTEL_EXPORTER_OTLP_ENDPOINT=
